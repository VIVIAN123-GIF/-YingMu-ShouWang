[Unit]
Description=YingMu ShouWang - FastAPI Backend API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/yingmu
EnvironmentFile=/opt/yingmu/.env
ExecStart=/opt/yingmu/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8002 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
