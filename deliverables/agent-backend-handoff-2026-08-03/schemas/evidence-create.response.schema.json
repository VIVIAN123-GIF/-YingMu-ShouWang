{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yingmu.local/schemas/v1/evidence-create.response.schema.json",
  "title": "EvidenceCreateResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence", "saved", "idempotent", "evaluation"],
  "properties": {
    "evidence": {
      "$ref": "../../../contracts/v1/schemas/evidence.schema.json"
    },
    "saved": {"type": "boolean"},
    "idempotent": {"type": "boolean"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_level",
        "event_created",
        "event_id",
        "matched_rule",
        "ruleset_version",
        "system_evidence_id"
      ],
      "properties": {
        "risk_level": {"enum": ["GREEN", "YELLOW", "ORANGE", "RED"]},
        "event_created": {"type": "boolean"},
        "event_id": {
          "type": ["string", "null"]
        },
        "matched_rule": {"type": "string", "minLength": 1},
        "ruleset_version": {"const": "ruleset-v1.0"},
        "system_evidence_id": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
