{
  "name": "yingmu-family-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "test": "vitest run",
    "test:watch": "vitest",
    "evidence": "playwright test --config playwright.config.js",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "evidence:api": "python scripts/run_api_evidence.py",
    "verify:agent-api": "python scripts/validate_agent_api_frontend.py",
    "media:build": "powershell -ExecutionPolicy Bypass -File scripts/build_browser_media.ps1",
    "media:verify": "node scripts/verify_browser_media.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.11.0",
    "echarts": "^6.0.0",
    "element-plus": "^2.10.4",
    "flv.js": "^1.6.2",
    "js-sha256": "^1.0.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "unplugin-auto-import": "^20.1.0",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
