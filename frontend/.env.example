VITE_API_BASE_URL=/api/v1
# Development-only Vite proxy override, for example http://127.0.0.1:8010.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
# BFF media requires the login page to exchange credentials for an HttpOnly cookie.
VITE_MEDIA_BFF_ENABLED=true
VITE_DEMO_LOGIN_ENABLED=true
VITE_DATA_MODE=auto
VITE_RESIDENT_ID=resident-001
VITE_AUTHORIZED_CLIP_URL=
VITE_ROUTER_MODE=history
VITE_PAGES_BUILD=false
VITE_DEMO_USER=
VITE_DEMO_PASSWORD_SHA256=
VITE_BASE_PATH=/
