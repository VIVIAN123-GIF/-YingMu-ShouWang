{
  "ruleset_version": "ruleset-v1.0",
  "context_policy_version": "env-context-v1.0",
  "engineering_initials": true,
  "windows": {
    "short_seconds": 30,
    "medium_hours": 24,
    "long_days": 7
  },
  "thresholds": {
    "data_quality": 0.7,
    "confidence": 0.7,
    "high_confidence": 0.8,
    "stable_posture_seconds": 15,
    "observation_seconds": 60,
    "no_response_seconds": 60,
    "persistent_evidence_count": 3,
    "orange_score": 0.7,
    "red_score": 0.9
  },
  "risk_weights": {
    "severity": 0.45,
    "confidence": 0.30,
    "data_quality": 0.15,
    "context": 0.10
  },
  "context_factors": {
    "night": 0.25,
    "low_light": 0.25,
    "repeated_daily_abnormality": 0.20,
    "yellow_state": 0.40,
    "long_term_deviation": 0.20,
    "high_risk_zone": 0.25,
    "obstacle_interaction": 0.20
  },
  "rules": [
    {"id": "R-FALL-01", "name": "single rapid rise", "result": "GREEN_WAIT"},
    {"id": "R-FALL-02", "name": "rapid rise plus trunk sway", "result": "ORANGE_INTERVENING"},
    {"id": "R-FALL-03", "name": "low quality evidence", "result": "SYSTEM_NO_UPGRADE"},
    {"id": "R-FALL-04", "name": "posture recovered", "result": "OBSERVING"},
    {"id": "R-FALL-05", "name": "observation completed", "result": "RESOLVED"},
    {"id": "R-FALL-06", "name": "hazard during observation", "result": "INTERVENING"},
    {"id": "R-FALL-07", "name": "persistent hazard, no response, or hazard after two interventions", "result": "RED_ESCALATED"},
    {"id": "R-MENTAL-00", "name": "low quality mental trend evidence", "result": "NO_UPGRADE"},
    {"id": "R-MENTAL-01", "name": "non-clinical trend deviation", "result": "YELLOW_OPEN"},
    {"id": "R-MENTAL-02", "name": "family contact completed", "result": "OBSERVING"},
    {"id": "R-MENTAL-03", "name": "structured trend recovered", "result": "RESOLVED"},
    {"id": "R-FRAUD-00", "name": "low quality fraud verification evidence", "result": "NO_UPGRADE"},
    {"id": "R-FRAUD-01", "name": "single verification indicator", "result": "YELLOW_OPEN"},
    {"id": "R-FRAUD-02", "name": "visitor plus dwell plus risk words within 30 minutes", "result": "ORANGE_INTERVENING"},
    {"id": "R-FRAUD-03", "name": "identity or false alarm verified", "result": "CLOSED"},
    {"id": "R-SYSTEM-01", "name": "duplicate evidence", "result": "IDEMPOTENT"}
  ]
}
