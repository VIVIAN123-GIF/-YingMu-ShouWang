    "PROVISIONAL": {"human_risk": 0.65, "personal_deviation": 0.1, "environment_risk": 0.1, "interaction_risk": 0.15},
    "STABLE": {"human_risk": 0.55, "personal_deviation": 0.2, "environment_risk": 0.1, "interaction_risk": 0.15}
  },
  "context_factors": {
    "night": 0.25,
    "low_light": 0.25,
