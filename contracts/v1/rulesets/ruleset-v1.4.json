  "severity_saturation": {
    "trunk_sway": 30.0,
    "post_rise_lateral_drift": 0.7,
    "support_base_change": 0.6,
    "compensatory_step": 2.0,
    "gait_instability": 0.8,
    "relative_speed_change": 0.8
  },
