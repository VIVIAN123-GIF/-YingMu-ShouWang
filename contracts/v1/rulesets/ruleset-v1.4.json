    "stable_mad_multiplier": 2.5,
    "orange_min_signal_families": 2,
    "orange_score": 0.7,
    "red_score": 0.9,
    "low_illumination_norm": 0.18,
    "occlusion_min_seconds": 1.5,
    "multi_person_min_seconds": 0.5,
    "core_low_visibility_ratio": 0.2,
