    "yellow_state": 0.4,
    "long_term_deviation": 0.2,
    "high_risk_zone": 0.25,
    "obstacle_interaction": 0.2
  },
  "ablation_configs": {
    "A": {"personal_baseline": true, "medium_memory": true, "long_memory": true, "quality_gate": true, "context": true, "offline_only": false},
    "B": {"personal_baseline": false, "medium_memory": true, "long_memory": true, "quality_gate": true, "context": true, "offline_only": false},
    "C": {"personal_baseline": false, "medium_memory": false, "long_memory": false, "quality_gate": true, "context": true, "offline_only": false},
    "D": {"personal_baseline": true, "medium_memory": true, "long_memory": true, "quality_gate": false, "context": false, "offline_only": true}
