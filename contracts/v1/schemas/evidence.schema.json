{
  "$defs": {
    "RiskDomain": {
      "enum": [
        "FALL",
        "MENTAL",
        "FRAUD",
        "SYSTEM"
      ],
      "title": "RiskDomain",
      "type": "string"
    },
    "SourceMode": {
      "enum": [
        "LIVE_DEVICE",
        "RECORDED_REPLAY",
        "PUBLIC_DATASET",
        "MOCK"
      ],
      "title": "SourceMode",
      "type": "string"
    },
    "TimeScale": {
      "enum": [
        "SHORT",
        "MEDIUM",
        "LONG"
      ],
      "title": "TimeScale",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "evidence_id": {
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
    },
    "observation_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Observation Ids",
      "type": "array"
    },
    "resident_id": {
      "minLength": 1,
      "title": "Resident Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "risk_domain": {
      "$ref": "#/$defs/RiskDomain"
    },
    "evidence_type": {
      "enum": [
        "activity_range_baseline_sample",
        "activity_range_decline",
        "audio_quality_low",
        "camera_occlusion",
        "circadian_baseline_sample",
        "day_night_rhythm_change",
        "false_alarm_confirmed",
        "family_concern",
        "family_contact_completed",
        "fraud_keyword",
        "gait_instability",
        "gait_stability_baseline_sample",
        "high_risk_zone_entry",
        "identity_verified",
        "low_illumination",
        "low_light",
        "mental_self_report",
        "no_response",
        "normal_baseline_sample",
        "obstacle_occupancy",
        "persistent_instability",
        "posture_recovered",
        "professional_support_suggested",
        "quality_gate_failed",
        "rapid_rise",
        "relative_speed_change",
        "rise_duration_baseline_sample",
        "room_transition_decline",
        "slow_rise",
        "stream_unavailable",
        "tracking_lost",
        "trend_recovered",
        "trunk_sway",
        "trunk_sway_baseline_sample",
        "unauthorized_visitor",
        "unusual_dwell_time",
        "unusual_pacing",
        "voluntary_screening_concern"
      ],
      "minLength": 1,
      "title": "Evidence Type",
      "type": "string",
      "x-internal-only": [
        "no_response",
        "persistent_instability",
        "quality_gate_failed"
      ]
    },
    "severity": {
      "title": "Severity",
      "type": "number"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    },
    "data_quality": {
      "title": "Data Quality",
      "type": "number"
    },
    "baseline_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Value"
    },
    "current_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Value"
    },
    "baseline_deviation": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Deviation"
    },
    "time_scale": {
      "$ref": "#/$defs/TimeScale"
    },
    "location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Location"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "adapter_version": {
      "minLength": 1,
      "title": "Adapter Version",
      "type": "string"
    },
    "source_mode": {
      "$ref": "#/$defs/SourceMode"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "observation_ids",
    "resident_id",
    "timestamp",
    "risk_domain",
    "evidence_type",
    "severity",
    "confidence",
    "data_quality",
    "baseline_value",
    "current_value",
    "baseline_deviation",
    "time_scale",
    "location",
    "explanation",
    "adapter_version",
    "source_mode",
    "simulated"
  ],
  "title": "Evidence",
  "type": "object"
}
