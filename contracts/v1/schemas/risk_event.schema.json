{
  "$defs": {
    "EventStatus": {
      "enum": [
        "OPEN",
        "INTERVENING",
        "OBSERVING",
        "RESOLVED",
        "ESCALATED",
        "FALSE_ALARM"
      ],
      "title": "EventStatus",
      "type": "string"
    },
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "minLength": 1,
          "title": "Evidence Type",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "explanation"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "RiskDomain": {
      "enum": [
        "FALL",
        "MENTAL",
        "FRAUD",
        "SYSTEM"
      ],
      "title": "RiskDomain",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "GREEN",
        "YELLOW",
        "ORANGE",
        "RED"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "SourceMode": {
      "enum": [
        "LIVE_DEVICE",
        "RECORDED_REPLAY",
        "PUBLIC_DATASET",
        "MOCK"
      ],
      "title": "SourceMode",
      "type": "string"
    },
    "TimeHorizon": {
      "enum": [
        "TREND",
        "TODAY",
        "IMMINENT"
      ],
      "title": "TimeHorizon",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "resident_id": {
      "minLength": 1,
      "title": "Resident Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "primary_domain": {
      "$ref": "#/$defs/RiskDomain"
    },
    "related_domains": {
      "items": {
        "$ref": "#/$defs/RiskDomain"
      },
      "title": "Related Domains",
      "type": "array"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "risk_score": {
      "title": "Risk Score",
      "type": "number"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "evidence_summary": {
      "items": {
        "$ref": "#/$defs/EvidenceSummary"
      },
      "minItems": 1,
      "title": "Evidence Summary",
      "type": "array"
    },
    "time_horizon": {
      "$ref": "#/$defs/TimeHorizon"
    },
    "recommended_action": {
      "minLength": 1,
      "title": "Recommended Action",
      "type": "string"
    },
    "intervention_policy": {
      "minLength": 1,
      "title": "Intervention Policy",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EventStatus"
    },
    "ruleset_version": {
      "minLength": 1,
      "title": "Ruleset Version",
      "type": "string"
    },
    "source_mode": {
      "$ref": "#/$defs/SourceMode"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "resident_id",
    "created_at",
    "updated_at",
    "primary_domain",
    "related_domains",
    "risk_level",
    "risk_score",
    "evidence_ids",
    "evidence_summary",
    "time_horizon",
    "recommended_action",
    "intervention_policy",
    "status",
    "ruleset_version",
    "source_mode",
    "simulated"
  ],
  "title": "RiskEvent",
  "type": "object"
}
