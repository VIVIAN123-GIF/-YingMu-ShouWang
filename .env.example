YINGMU_ENV=mock
YINGMU_DB_PATH=ezviz_system.db
EZVIZ_APP_KEY=
EZVIZ_APP_SECRET=
EZVIZ_ACCESS_TOKEN=
EZVIZ_ACCESS_TOKEN_EXPIRES_AT=
EZVIZ_DEVICE_SERIAL=
EZVIZ_CHANNEL_NO=1
# 2026-08-24 H.264 实机基线：4=HTTP-FLV 已验证；2=HLS 仅作兼容回退。
# 切换协议或设备编码后必须重新运行 scripts/validate_ezviz_live.py --stream-probe。
EZVIZ_LIVE_PROTOCOL=4
# 1=高清主码流，2=流畅子码流。当前 C6C 主码流 H.264 已通过实机验证。
EZVIZ_LIVE_QUALITY=1
# 抓图接口可能比设备状态查询更慢；默认 45 秒，可按现场网络调整。
EZVIZ_CAPTURE_TIMEOUT_SECONDS=45
EZVIZ_STATUS_TIMEOUT_SECONDS=5
YINGMU_CAPTURE_MEDIA_MODE=VIDEO
# 环形缓冲不可用时使用的告警后录制窗口。
YINGMU_VIDEO_CAPTURE_SECONDS=15
# winget 安装后，旧终端/后台进程可能继承旧 PATH；此时改为已验证的绝对路径。
YINGMU_FFMPEG_BINARY=ffmpeg
# Optional pre-alarm ring buffer. The buffer root must be outside the repository.
YINGMU_STREAM_BUFFER_ENABLED=false
YINGMU_STREAM_BUFFER_ROOT=
YINGMU_STREAM_BUFFER_SEGMENT_SECONDS=2
YINGMU_STREAM_BUFFER_PRE_SECONDS=10
YINGMU_STREAM_BUFFER_POST_SECONDS=20
YINGMU_STREAM_BUFFER_RETENTION_SECONDS=60
YINGMU_STREAM_BUFFER_RECONNECT_SECONDS=3
YINGMU_STREAM_BUFFER_SELECTION_RETRY_SECONDS=8
YINGMU_STREAM_BUFFER_MAX_ALARM_DELAY_SECONDS=20
YINGMU_STREAM_BUFFER_STALL_SECONDS=8
# 设备视频加密验证码；仅保存于本地 .env，不得提交或写入验收报告。
EZVIZ_DEVICE_VERIFY_CODE=
EZVIZ_RESIDENT_ID=
EZVIZ_DEVICE_MODEL=EZVIZ_C6C
# 真实抓拍只允许保存到仓库/OneDrive之外的私有目录。
YINGMU_PRIVATE_MEDIA_ROOT=
YINGMU_CAMERA_POSITION_ID=living-room-c6c-v1
YINGMU_AUTHORIZATION_RECORD_ID=
YINGMU_RETENTION_UNTIL=
YINGMU_SNAPSHOT_MAX_BYTES=10485760
YINGMU_SNAPSHOT_DOWNLOAD_TIMEOUT_SECONDS=30
# Optional structured text-model provider; leave blank to use template fallback.
AGENT_LLM_BASE_URL=https://openai.ezviz.com/v1
# Token Switch key; EZVIZ_API_KEY is also accepted as a compatibility alias.
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=qwen3.6-flash
# Ezviz Token Switch qwen3.6-flash measured about 24s for a structured response.
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_OUTPUT_TOKENS=400
# Supplemental v1.4 runtime. Frozen P03 tools keep their explicitly pinned
# v1.2/v1.3 rules and legacy adapter.
YINGMU_RULESET_VERSION=ruleset-v1.4
YINGMU_FOREWARNING_RULESET_VERSION=ruleset-v1.4
YINGMU_GAIT_ADAPTER=contracts.v1.gait_adapter_v14:run
# Local MediaPipe model used when the gait adapter receives MP4/AVI/MOV/MKV/WebM.
YINGMU_GAIT_POSE_MODEL=models/pose_landmarker_heavy.task
# Real CPU MP4 inference is slower than clip duration; keep within the
# AlgorithmJob contract maximum of 120 seconds.
YINGMU_ALGORITHM_TIMEOUT_SECONDS=90
YINGMU_TRAJECTORY_ADAPTER=adapters.trajectory_adapter:run
YINGMU_LANGUAGE_ADAPTER=adapters.language_adapter:run
# Worker 必须同时导入仓库合同与行为适配器；Windows 使用分号分隔。
PYTHONPATH=.;.\deliverables\cym\audio-behavior-demo\src
YINGMU_SCENE_CONFIG_ID=scene-living-room-v1
# Local fixed-camera SceneCalibration JSON directory. Configurations contain
# normalized zones only; never include device credentials or participant data.
YINGMU_SCENE_CONFIG_DIR=scene-calibrations
YINGMU_LOCATION=living_room
# 云信令 > 消息推送中设置的签名密钥；仅保存于本地 .env。
EZVIZ_WEBHOOK_SECRET=
EZVIZ_WEBHOOK_ALLOW_UNSIGNED_TEST=false
# 平台请求头 t 的最大可接受时间偏移（秒）。
EZVIZ_WEBHOOK_MAX_AGE_SECONDS=300
# 仅在真实设备调用日志确认语音能力后设为 true
EZVIZ_VOICE_VERIFIED=false
EZVIZ_LIVE_PLAYBACK_VERIFIED=false
# 现场网关停止采集接口的共享控制令牌（不得提交真实值）
YINGMU_CONTROL_TOKEN=
YINGMU_MEDIA_ACCESS_TOKEN=
# BFF login/session settings. Password is SHA-256 hex; keep all real values server-side.
YINGMU_BFF_SESSION_SECRET=
YINGMU_BFF_USERNAME=
YINGMU_BFF_PASSWORD_SHA256=
YINGMU_BFF_SESSION_TTL_SECONDS=900
YINGMU_BFF_COOKIE_SECURE=false
YINGMU_LIVE_VIEW_ENABLED=false
YINGMU_LIVE_STREAM_TIMEOUT_SECONDS=30
YINGMU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MIN_EVIDENCE_QUALITY=0.70
MIN_EVIDENCE_CONFIDENCE=0.70
